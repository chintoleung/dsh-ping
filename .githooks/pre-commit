#!/bin/sh
# Refuse to commit maintainer-private files — even when staged via `git add -f`.
# The denylist mirrors .gitignore; keep the two in sync.
blocked=$(git diff --cached --name-only | grep -Ei '(^|/)(agents\.md|hermes-runbook\.md|.*\.hermes\.md)$' || true)
if [ -n "$blocked" ]; then
  echo "pre-commit: REFUSING to commit maintainer-private file(s):" >&2
  echo "$blocked" >&2
  echo "These are gitignored on purpose — see AGENTS.md. Unstage them" >&2
  echo "(git restore --staged <file>) and commit without them." >&2
  exit 1
fi
exit 0
